[Unit]
Description=GrowPi Greenhouse Controller
Documentation=https://github.com/cubetribe/GrowPi
After=network.target pigpiod.service
Requires=pigpiod.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/opt/grow-pi

# Main executable
ExecStart=/opt/grow-pi/venv/bin/python -m grow_pi.main

# Runtime directory für PWM State-Files (Zero-Downtime Feature #0)
# Wird von systemd erstellt unter /run/growpi/
RuntimeDirectory=growpi
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Restart policy - schneller restart für Zero-Downtime
Restart=always
RestartSec=5

# Environment
Environment=PYTHONUNBUFFERED=1

# Logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grow-pi

# Graceful shutdown - Zeit für State-Save (Zero-Downtime)
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM

# Security hardening
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target

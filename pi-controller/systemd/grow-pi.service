[Unit]
Description=GrowPi Greenhouse Controller
Documentation=https://github.com/cubetribe/GrowPi
After=network-online.target pigpiod.service
Wants=network-online.target
Requires=pigpiod.service
StartLimitIntervalSec=300
StartLimitBurst=5
StartLimitAction=reboot-force

[Service]
Type=notify
User=admin
Group=admin
WorkingDirectory=/opt/grow-pi

# Main executable
ExecStart=/opt/grow-pi/venv/bin/python -m grow_pi.main --no-web

# Runtime directory für PWM State-Files (Zero-Downtime Feature #0)
# Wird von systemd erstellt unter /run/growpi/
RuntimeDirectory=growpi
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# Restart policy
Restart=on-failure
RestartSec=3
RestartPreventExitStatus=0 SIGTERM SIGINT

# Watchdog Configuration (Tank-Mode)
# Service muss alle 60s ein WATCHDOG=1 Signal senden
# Sonst wird es als gehangen erkannt und neu gestartet
WatchdogSec=60
WatchdogSignal=SIGKILL

# Environment
Environment=PYTHONUNBUFFERED=1

# Logging to journald
StandardOutput=journal
StandardError=journal
SyslogIdentifier=grow-pi

# Graceful shutdown - Zeit für State-Save (Zero-Downtime)
TimeoutStartSec=120
TimeoutStopSec=30
KillMode=mixed
KillSignal=SIGTERM
OOMPolicy=kill

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/grow-pi /run/growpi
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictRealtime=true
RestrictSUIDSGID=true
UMask=0027
TasksMax=512

[Install]
WantedBy=multi-user.target
